rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny Catch-all Security Layer
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Validates if the authenticated request matches the bootstrapped admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'alexkorogo@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // Products Catalog Rules
    match /products/{productId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        // Public checkout allowed to decrement / update stock only
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.retailPrice == resource.data.retailPrice &&
        request.resource.data.buyPrice == resource.data.buyPrice
      );
    }

    // Clients Orders Rules
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Admin Notifications Rules
    match /notifications/{notificationId} {
      allow create: if isValidNotification(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Shop Settings Rules
    match /settings/{settingsId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Helper: Verifies valid order payload parameters on client creation (Zero-Trust)
    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.customerPhone is string && data.customerPhone.size() <= 50 &&
             data.city is string && data.city.size() <= 100 &&
             data.paymentMethod is string &&
             data.items is list && data.items.size() > 0 &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.totalProfit is number &&
             data.status == 'En attente' &&
             data.createdAt is string;
     }

    // Helper: Verifies valid notification details on client creation (Zero-Trust)
    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type is string && data.type.size() <= 50 &&
             data.createdAt is string &&
             data.read == false;
    }
  }
}
